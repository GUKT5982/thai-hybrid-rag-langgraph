# Copy to .env and fill in. config.py reads all of these; nothing is
# hardcoded elsewhere in the codebase.

# --- Data ---
DATA_MODE=sample                # sample (smart sample, see README "sample mode had to be redesigned") | full (542,166)
DATA_SAMPLE_SIZE=5000            # sample mode: extra BACKFILL distractor passages on top of the ~9.7k
                                  # NoMIRACL-dev gold passages that are always included — not a hard total cap
DATA_CACHE_DIR=./data_cache
CORPUS_REPO=miracl/miracl-corpus
CORPUS_LANG=th
NOMIRACL_REPO=miracl/nomiracl
NOMIRACL_LANG=thai

# --- Postgres + pgvector ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=thai_rag
PGUSER=postgres
PGPASSWORD=
PGVECTOR_TABLE=passages
EMBEDDING_DIM=768                # must match the embedding model's output dim

# --- Retrieval / fusion / rerank ---
USE_NEWMM=true                   # false = negative arm of the newmm ablation only
BM25_K=20
VECTOR_K=20
RRF_K=60                         # Reciprocal Rank Fusion constant, see nodes/fusion.py
FUSION_TOP_K=20
RERANK_TOP_K=5
MAX_QUERY_VARIANTS=3
MAX_RETRIES=2                    # grade_documents -> query_rewrite retry cap

# --- Models ---
LLM_PROVIDER=anthropic           # anthropic | openai | ollama
LLM_MODEL=claude-sonnet-5        # ollama: e.g. llama3, or anything `ollama list` shows
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434   # only used when LLM_PROVIDER=ollama; needs `ollama serve` running.
                                          # A cloud-routed model name (e.g. "*:cloud") talks to ollama.com over
                                          # HTTPS through your local daemon — if that network path is blocked,
                                          # it fails with a TLS handshake error; a fully local model (e.g. llama3)
                                          # doesn't leave the machine. Small local models often ignore
                                          # "answer only in Thai" — check generate() output for that before
                                          # trusting Mode A numbers from one.

# --- Windows only ---
# If Thai text prints as mojibake in your terminal, that's a console
# codepage issue (often cp874), not a data bug — the underlying strings
# are correct UTF-8. Fix the terminal, not the code:
#   PYTHONIOENCODING=utf-8
